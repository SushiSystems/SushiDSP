PROJECT_NAME           = "SushiDSP"
PROJECT_BRIEF          = "Portable amp/pedal DSP framework — C++ API reference"
PROJECT_NUMBER         = "v1 (unreleased)"
OUTPUT_DIRECTORY       = build/docs/api-site
HTML_OUTPUT            = html
GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
INPUT                  = docs/reference/API_REFERENCE.md \
                         modules/foundation
FILE_PATTERNS          = *.hpp *.h
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/reference/API_REFERENCE.md
EXCLUDE_PATTERNS       = */detail/* */Detail/* */experimental/* */source/*
EXCLUDE_SYMBOLS        = *::Detail *::Detail::* *::detail *::detail::*
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = build/docs/api-site/doxygen-warnings.log
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SORT_MEMBER_DOCS       = YES
ALPHABETICAL_INDEX     = YES
SOURCE_BROWSER         = NO
QUIET                  = YES
