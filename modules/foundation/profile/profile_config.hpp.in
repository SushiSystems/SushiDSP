/**
 * @file profile_config.hpp
 * @brief Defines the profiler switch and level the build chose, for every profile header.
 * @author Mustafa Garip
 * @see modules/foundation/profile/README.md
 */

#pragma once

/// @brief 1 when the build records through SushiProfiler, 0 when every zone compiles to nothing.
#define SD_ENABLE_PROFILER @SD_ENABLE_PROFILER_VALUE@

/// @brief The density level the build compiles in: 1 stages, 2 fine, 3 per element.
#define SD_PROFILE_LEVEL @SD_PROFILE_LEVEL@
